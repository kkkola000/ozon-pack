@echo off
rem ---------------------------------------------------------------
rem  Агент печати Ozon Pack для Windows.
rem  1. Установите Python с python.org (галочка "Add python.exe to PATH").
rem  2. Положите рядом print-agent.py и этот файл.
rem  3. Впишите адрес панели и ключ из настроек (Настройки -> Агент печати).
rem  4. Запустите двойным щелчком.
rem  Автозапуск: Win+R -> shell:startup -> положить туда ярлык на этот файл.
rem ---------------------------------------------------------------
chcp 65001 >nul

set OZP_URL=https://seller.example.com
set OZP_TOKEN=ВСТАВЬТЕ_КЛЮЧ_ИЗ_НАСТРОЕК

rem Адрес принтера берётся из настроек панели. Чтобы задать его здесь,
rem раскомментируйте строку ниже:
rem set OZP_PRINTER=192.168.1.50:9100

title Агент печати Ozon Pack
python "%~dp0print-agent.py"
if errorlevel 1 (
  echo.
  echo Агент завершился с ошибкой. Окно останется открытым, чтобы её было видно.
  pause
)
