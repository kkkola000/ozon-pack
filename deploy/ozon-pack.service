# Установка без Docker:
#   sudo cp deploy/ozon-pack.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ozon-pack
[Unit]
Description=Ozon Pack — панель сборки FBS и возвратов
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ozon
Group=ozon
WorkingDirectory=/opt/ozon-pack
# Умолчания на случай, если .env не завели: панель откроется по адресу сервера.
# EnvironmentFile идёт следом, поэтому значения из .env перекрывают эти.
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
EnvironmentFile=/opt/ozon-pack/.env
# Адрес и порт берутся из .env: ssl.sh и vpn-only.sh закрывают прямой доступ,
# выставляя там HOST=127.0.0.1. Захардкоженный адрес делал бы эту правку
# бесполезной — панель продолжала бы слушать все интерфейсы.
ExecStart=/opt/ozon-pack/.venv/bin/uvicorn app.main:app --host ${HOST} --port ${PORT} --proxy-headers
Restart=always
RestartSec=5

# Ограничения: сервису нужен только свой каталог
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ozon-pack/data

[Install]
WantedBy=multi-user.target
