# ---- Ключи площадок ----
# Обычный путь — вносить ключи в самой панели: Настройки -> Кабинеты.
# Там же добавляются вторые магазины и кабинеты Avito; перезапуск не нужен.
#
# Значения ниже — запасной вариант для первого кабинета Ozon.
# Личный кабинет Ozon -> Настройки -> Seller API -> Сгенерировать ключ
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_API_URL=https://api-seller.ozon.ru

# Avito: ключи только в панели (Личный кабинет Avito -> Настройки -> Профиль -> API)
AVITO_API_URL=https://api.avito.ru
# За сколько дней назад запрашивать заказы Avito
AVITO_DAYS_BACK=30

# ---- Сервер ----
# Адрес, который слушает панель. Снаружи к ней ходят только через nginx,
# поэтому по умолчанию — localhost: прямого входа по http://IP-сервера:8080
# нет вовсе. Менять это значит открывать вторую дверь в панель.
HOST=127.0.0.1
PORT=8080
# Чьему заголовку X-Forwarded-For верить, определяя адрес посетителя. Менять
# только если панель действительно стоит за обратным прокси, и указывать его
# адрес, а не «*»: со звёздочкой любой подделает свой IP и обойдёт IP_ALLOWLIST
# вместе с защитой от подбора пароля.
#   nginx на том же сервере, панель службой  -> 127.0.0.1
#   nginx на том же сервере, панель в Docker -> подсеть моста, напр. 172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1
# Оставьте пустым — ключ сгенерируется и сохранится в data/.secret_key.
# Этим же секретом шифруются ключи площадок в базе: если его сменить или
# потерять, сессии сбросятся, а ключи Ozon и Avito придётся ввести заново
# в «Настройках» (сама панель при этом работает и честно скажет об этом).
SECRET_KEY=
DB_PATH=data/ozon-pack.db
# Пароль администратора при первом запуске. Если пусто — будет создан и напечатан в лог.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
SESSION_TTL_HOURS=24
# Кому панель вообще отвечает: адреса и подсети через запятую. Пусто — всем.
# Это второй уровень «только из VPN» рядом с правилом nginx: правило может
# отвалиться вместе с конфигом сайта, а эта проверка живёт в самой панели.
# Заполняет его deploy/vpn-only.sh; снаружи запрос получает 403 ещё до формы
# входа. Адрес 127.0.0.1 разрешён всегда, даже если его нет в списке, — через
# него ходят проверка здоровья и скрипты, и он же путь восстановления по SSH.
# Пример: 127.0.0.1,10.8.0.0/24
IP_ALLOWLIST=

# ---- Синхронизация ----
SYNC_ENABLED=1
SYNC_INTERVAL=60
SYNC_RETURNS_INTERVAL=300
SYNC_DAYS_BACK=30
SYNC_DAYS_FORWARD=30

# ---- Логика сборки ----
# Требовать скан каждого товара перед закрытием отправления
REQUIRE_ALL_ITEMS=1
# Автоматически отправлять стикер на печать при выборе отправления
AUTOPRINT=1
# Собирать отправление в Ozon прямо при скане товара (по умолчанию — вручную кнопкой)
AUTO_SHIP_ON_SCAN=0
# Сколько минут отправление закреплено за сборщиком
CLAIM_TTL_MINUTES=30
# Часовой пояс склада (смещение от UTC)
TZ_OFFSET_HOURS=3
# Статусы возвратов, считающиеся «готов к выдаче» (sys_name из /v1/returns/list)
RETURNS_READY_STATUSES=ArrivedAtReturnPlace
